{
  "name": "buwiz-books",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev --port 3000",
    "dev:test": "E2E_BYPASS_R2=true BYPASS_RATE_LIMITS=true BETTER_AUTH_URL=http://localhost:${E2E_PORT:-3001} bun --env-file=.env.test --bun vite dev --port ${E2E_PORT:-3001}",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "start": "bun run .output/server/index.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project=unit",
    "test:integration": "vitest run --project=integration",
    "test:component": "vitest run --project=component",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run db:test:fresh && playwright test",
    "test:e2e:ui": "bun run db:test:fresh && playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:all": "bun run test:unit && bun run test:component && bun run test:integration",
    "db:test:reset": "psql ${TEST_DATABASE_URL:-postgresql://uriah@localhost:5432/buwiz-books-tests} -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'",
    "db:test:fresh": "bun run db:test:reset && bun --env-file=.env.test run db:migrate && bun --env-file=.env.test run db:rls && bun --env-file=.env.test run db:rls:hardening && bun --env-file=.env.test run db:seed && bun --env-file=.env.test run db:seed:review-rules && bun --env-file=.env.test run db:seed:transactions",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts apply",
    "db:migrations:status": "bun run scripts/migrate.ts status",
    "db:migrations:verify": "bun run scripts/migrate.ts verify",
    "db:migrations:pre-schema": "bun run scripts/migrate.ts apply --phase=pre_schema",
    "db:migrations:post-schema": "bun run scripts/migrate.ts apply --phase=post_schema",
    "business-groups:entitlement": "bun run scripts/business-group-entitlement.ts",
    "business-groups:projection": "bun run scripts/business-group-projection.ts",
    "db:dedup:validate": "bun run scripts/validate-dedup-constraints.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "psql \"${DATABASE_URL:?DATABASE_URL is not set. bun does NOT expand .env into psql package scripts — run: DATABASE_URL=\\\"$(grep -m1 '^DATABASE_URL=' .env | cut -d= -f2-)\\\" bun run db:reset}\" -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;'",
    "db:rls": "psql \"${DATABASE_URL:?DATABASE_URL is not set. bun does NOT expand .env into psql package scripts — run: DATABASE_URL=\\\"$(grep -m1 '^DATABASE_URL=' .env | cut -d= -f2-)\\\" bun run db:rls}\" -f drizzle/rls_policies.sql",
    "db:rls:hardening": "psql \"${DATABASE_URL:?DATABASE_URL is not set}\" -v ON_ERROR_STOP=1 -f drizzle/rls_hardening.sql",
    "db:seed": "bun run scripts/seed-superuser.ts",
    "db:seed:coa": "bun run scripts/seed-coa.ts",
    "db:seed:review-rules": "bun run scripts/seed-review-rules.ts",
    "db:review-rules:status": "bun run scripts/seed-review-rules.ts --status",
    "db:seed:invoices": "bun run scripts/seed-invoices.ts",
    "db:seed:transactions": "bun run tests/e2e/seed-snapshot.ts",
    "dedup:preflight": "bun run scripts/dedup-preflight.ts",
    "dedup:health": "bun run scripts/dedup-health.ts",
    "dedup:backfill": "bun run scripts/dedup-backfill.ts",
    "dedup:convert-legacy": "bun run scripts/convert-legacy-matches.ts",
    "db:fresh": "bun db:reset && bun db:migrate && bun db:rls && bun db:seed && bun db:seed:coa && bun db:seed:review-rules",
    "reset": "bun db:reset",
    "migrate": "bun db:migrate",
    "seed": "bun db:seed",
    "fresh": "bun db:fresh",
    "lint": "oxlint .",
    "fix": "oxlint --fix .",
    "fmt": "oxfmt --write . '!src/routeTree.gen.ts'",
    "fmt:check": "oxfmt --check . '!src/routeTree.gen.ts'",
    "check": "bun lint && bun fmt:check && bun typecheck",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "test:evals": "AI_EVALS_MODE=recorded bun run vitest run --config vitest.evals.config.ts",
    "test:evals:live": "AI_EVALS_MODE=live bun run vitest run --config vitest.evals.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.984.0",
    "@aws-sdk/s3-request-presigner": "^3.984.0",
    "@google/generative-ai": "^0.24.1",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-query": "^5.90.20",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-start": "^1.132.0",
    "better-auth": "^1.4.18",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "jspdf": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.561.0",
    "nitro": "npm:nitro-nightly@3.0.1-20260205-235024-8d921604",
    "openai": "^6.49.0",
    "pdf-to-img": "^5.0.0",
    "postgres": "^3.4.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "resend": "^6.9.1",
    "sharp": "^0.34.5",
    "stripe": "^22.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "usehooks-ts": "^3.1.1",
    "vite-tsconfig-paths": "^6.0.2",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "@tanstack/devtools-vite": "^0.5.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.43.0",
    "playwright": "^1.58.1",
    "typescript": "^5.7.2",
    "vite": "^7.1.7",
    "vitest": "^4.0.18"
  },
  "patchedDependencies": {
    "@tanstack/start-server-core@1.169.17": "patches/@tanstack%2Fstart-server-core@1.169.17.patch"
  }
}
