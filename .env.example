# ── Database (PostgreSQL) ────────────────────────────────────────
# Local: postgresql://postgres:postgres@localhost:5432/buwiz-books
# Production: mounted from the isolated Cloud SQL `database-url` secret.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buwiz-books
# Owner/BYPASSRLS connection for context-free paths (public invoice page,
# Stripe/PayPal capture). Optional until DATABASE_URL moves to the non-owner
# app_runtime role (drizzle/rls_hardening.sql) — falls back to DATABASE_URL.
DATABASE_URL_ADMIN=

# ── Managed migrations (scripts/migrate.ts) ──────────────────────
# Migration-owner connection. Required by every status/verify/apply run;
# DATABASE_URL_ADMIN is accepted as a fallback, and the serving DATABASE_URL is
# deliberately never accepted. The target is parsed before any client opens and
# the "localhost" alias is rejected, so write the loopback literal 127.0.0.1.
# Remote targets additionally require verified TLS.
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buwiz-books
# Schema synchronization is fail-closed. `apply` refuses to run any schema tool
# unless this exactly equals the migration target's database name above. Leave it
# empty for status and verify, which never synchronize.
MIGRATION_SCHEMA_SYNC_CONFIRM=
# `.env.test` needs its own copy of both variables pointing at the test database,
# because db:test:fresh applies migrations before Playwright runs.

# ── Branding (white-label) ───────────────────────────────────────
# All optional — unset falls back to the "Buwiz Books" defaults in
# src/config/brand.ts. Split across two runtimes, and the split matters:
#
#   VITE_*   client bundle, inlined by Vite at BUILD time. The canonical
#            deployment repository must supply approved build-time values.
#            Setting them on the Cloud Run service does nothing.
#   plain    server only (transactional email, PDFs, web manifest). VITE_* is
#            stripped from the server bundle, so these must be runtime env.
#
# Anything under VITE_* ships inside the public JS. Never put a secret there.
APP_NAME=
SUPPORT_EMAIL=
VITE_APP_NAME=
# Public origin. Also the org-slug prefix on the onboarding screen; when unset
# or localhost that falls back to buwiz.com.
VITE_APP_URL=
VITE_SUPPORT_EMAIL=
# Hex colors applied to --color-primary / --color-accent at runtime.
VITE_BRAND_PRIMARY=
VITE_BRAND_ACCENT=
# Empty logo URL means "use the built-in wordmark".
VITE_BRAND_LOGO_URL=
VITE_BRAND_FAVICON_URL=

# ── Better Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Production: https://your-domain.com
BETTER_AUTH_URL=http://localhost:3000

# ── Registration Mode ────────────────────────────────────────────
# Set to "true" to restrict sign-in to invited users only.
# When enabled, only users already in the system (invited via admin) can sign in.
# Default (false/unset): public registration — anyone can sign in.
INVITE_ONLY=false
# Bootstrap admin email — this email always bypasses the invite-only gate.
# Required for initial setup when INVITE_ONLY=true.
ADMIN_EMAIL=
# Comma-separated list of emails that skip OTP delivery (dev/test only).
# Example: dev@test.local,yourpersonal@example.com
OTP_SKIP_EMAILS=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Cloudflare R2 Storage ────────────────────────────────────────
STORAGE_PROVIDER=r2
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Format: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ── Secret encryption (at rest) ──────────────────────────────────
# Master key for encrypting organization credentials (Gemini/Stripe/PayPal/
# Resend keys, statement passwords, Gmail tokens) in the database.
# Generate with: openssl rand -base64 32   (must decode to 32 bytes)
# Required in production. Canonical deployment must own any plaintext backfill
# or key-rotation operation under an approved, audited runbook.
SECRETS_ENCRYPTION_KEY=
# Optional old key used during a canonical-deployment rotation. It must be
# removed from the serving revision after the audited rotation completes.
SECRETS_ENCRYPTION_KEY_PREVIOUS=

# ── Gemini AI ────────────────────────────────────────────────────
# Keys are configured per-organization in Settings → AI Credentials (BYOK)
# Override the default Gemini model (defaults to gemini-2.0-flash if unset)
GEMINI_DEFAULT_MODEL=

# ── Email (Resend) ───────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here
MAIL_FROM=invoices@yourdomain.com
# Verify Resend's inbound-email webhook before accepting payloads.
RESEND_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Protects POST /api/internal/worker and POST /api/internal/inbox-worker, which
# should only be called by the deployment scheduler/queue runner. Both routes
# return 500 while this is unset, so the self-trigger cannot drain anything.
# Generate with: openssl rand -base64 32
# Production: the canonical deployment repository must store and mount this
# secret and update the external scheduler header when it is rotated.
INBOX_WORKER_SECRET=
# Domain that Resend receives inbound mail for (MX pointed at Resend). Used to
# auto-generate per-org forwarding addresses like inbox-acme-k3f9q2@<domain>.
INBOUND_EMAIL_DOMAIN=inbound.yourdomain.com

# ── Background jobs (queue drain) ────────────────────────────────
# Enqueued work (email ingest, attachment extraction, OCR, matching) only runs
# when SOMETHING drains the queue. There are exactly two mechanisms, and with
# neither one active every job stays `queued` forever — silently, since
# enqueueing always succeeds:
#
#   inline    an in-process drain loop (this is what makes `bun dev` work)
#   off       an external scheduler POSTs /api/internal/worker on a timer
#             (production: external scheduler owned by canonical deployment)
#
# Unset defaults to `inline` outside production, `off` in production, and is
# forced `off` under test so a background drain cannot race the suites.
JOB_DRAIN_MODE=inline
# Base URL the fire-and-forget self-trigger posts to. Leave unset locally (it
# falls back to BETTER_AUTH_URL, then PORT). In production set it to the
# loopback address of the container's own port — otherwise the instance calls
# itself out through the public load balancer and back, a billable round trip
# that can cold-start a second instance.
# Cloud Run: INTERNAL_WORKER_URL=http://127.0.0.1:8080
INTERNAL_WORKER_URL=

# ── Enterprise Business Groups reporting ────────────────────────
# Safe rollout switch for holding-company portfolio reports:
#   live       current ledger queries (default and rollback mode)
#   shadow     return live results and persist material projection mismatches
#   projection use the set-based reporting projection
BUSINESS_GROUP_REPORT_SOURCE=live
# Account-scoped canary. This is consulted only when the global source is
# `shadow`: listed Enterprise accounts read projections, while every other
# account still receives live results with shadow reconciliation. Use canonical
# comma-separated Enterprise account UUIDs; malformed values are ignored.
BUSINESS_GROUP_PROJECTION_ACCOUNT_ALLOWLIST=
# Absolute per-metric difference recorded during shadow comparison.
BUSINESS_GROUP_PROJECTION_RECONCILIATION_TOLERANCE=0.01

# Platform-owned Stripe Billing configuration for Enterprise subscriptions.
# These credentials are distinct from per-organization invoice-payment keys.
STRIPE_ENTERPRISE_SECRET_KEY=
STRIPE_ENTERPRISE_WEBHOOK_SECRET=
STRIPE_ENTERPRISE_PRICE_ID=
# Dedicated portal configuration with subscription quantity changes disabled.
STRIPE_ENTERPRISE_PORTAL_CONFIGURATION_ID=

# ── Foreign exchange ─────────────────────────────────────────────
# Optional fallback when an imported transaction does not include its own rate.
OPEN_EXCHANGE_RATES_APP_ID=

# ── Historical GCP / Cloud Run reference (not consumed by Makefile) ─
# These identifiers document the prior target only. They are not production
# authorization or operator instructions. Canonical deployment owns current
# provider configuration and must verify its target independently.
CLOUDSDK_ACTIVE_CONFIG_NAME=buwiz-books

# Historical GCP project ID — the slug string, not the project number.
# Canonical deployment must resolve and verify its current value.
GCP_PROJECT_ID=buwiz-503321

# Cloud Run region (must match where the service was created)
GCP_REGION=europe-north1
GCP_REPO=buwiz-books-repo
SERVICE_NAME=buwiz-books
DB_INSTANCE=buwiz-books-db
DB_NAME=buwiz_books
CLOUD_SQL_CONNECTION_NAME=buwiz-503321:europe-north1:buwiz-books-db
CLIENT_DOMAIN=books.buwiz.com

# ── Dev-only one-click login bypass (NEVER enable in production) ─────────────
# Adds a "Dev login" button on /login and a POST /api/dev/login route that signs in
# as a test account without the email OTP or Google. Hard-gated: requires
# NODE_ENV != production AND DEV_LOGIN_BYPASS=true.
# DEV_LOGIN_BYPASS=true
# DEV_LOGIN_EMAIL=ceo@goldcoders.dev
# DEV_LOGIN_EMAILS=ceo@goldcoders.dev,owner@test.local   # optional allowlist
