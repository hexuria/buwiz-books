# Copy to `.env.test`. Required by `bun run db:test:fresh`, which `test:e2e` runs first.
#
# Three separate variables on purpose:
#   TEST_DATABASE_URL       psql drops and recreates the schema with this.
#   MIGRATION_DATABASE_URL  the migration engine parses this before any client opens.
#                           It rejects the "localhost" alias, so use the 127.0.0.1 literal.
#   MIGRATION_SCHEMA_SYNC_CONFIRM
#                           schema synchronization is fail-closed and refuses to run any
#                           schema tool unless this exactly equals the database name above.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buwiz-books-tests
MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buwiz-books-tests
MIGRATION_SCHEMA_SYNC_CONFIRM=buwiz-books-tests

# The serving credential the application itself reads during tests.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/buwiz-books-tests

BETTER_AUTH_SECRET=test-secret-not-for-production
